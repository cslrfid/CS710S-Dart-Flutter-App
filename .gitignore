# =============================================================================
# Root .gitignore for the CS710S Flutter app (developed in Android Studio).
# Flutter-/Dart-specific patterns live in cs710flutterapp/.gitignore.
# =============================================================================

##### Operating System #####

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


##### Android Studio / IntelliJ / JetBrains IDEs #####
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# Whole .idea folder — Android Studio recreates it on first open and most of
# the per-user state below is noise. Uncomment specific files (e.g. codeStyles)
# if the team decides to share them.
.idea/

# Module files (regenerated by Gradle/Flutter sync)
*.iml
*.ipr
*.iws

# Android Studio captures, navigation editor, lint outputs
captures/
.navigation/
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Android Studio 3+ serialised caches
.idea/caches/build_file_checksums.ser

# CMake / external native build artefacts (CSL SDK is BLE only, but leave
# these in case future native code is added)
.externalNativeBuild/
.cxx/
cmake-build-*/


##### Gradle #####
.gradle/
build/
gradle-app.setting
.gradletasknamecache

# Keep the wrapper jar even though *.jar is otherwise ignored
!gradle/wrapper/gradle-wrapper.jar


##### Android build artefacts #####
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties

# Keystore files — never commit production signing material
*.jks
*.keystore


##### Xcode (iOS build under cs710flutterapp/ios/) #####
xcuserdata/
DerivedData/
*.xcuserstate
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3


##### Editors (non-AS contributors) #####
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace


##### Logs / backups / temporary #####
*.log
*.bak
*.tmp
*.orig
