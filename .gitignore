# =============================================================================
# Root .gitignore for the CS710S Flutter app (developed in Android Studio).
# =============================================================================

##### Operating System #####

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


##### Android Studio / IntelliJ / JetBrains IDEs #####
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# Whole .idea folder — AS recreates it on first open and most of the
# per-user state is noise. Uncomment specific files (e.g. codeStyles)
# if the team decides to share them.
.idea/

# Module files (regenerated by Gradle / Flutter sync)
*.iml
*.ipr
*.iws

# Android Studio captures, navigation editor, lint outputs
captures/
.navigation/
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# AS 3+ serialised caches
.idea/caches/build_file_checksums.ser

# CMake / external native build artefacts
.externalNativeBuild/
.cxx/
cmake-build-*/


##### Other Editors #####

# VS Code (keep shared workspace config, ignore per-user)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Vim / Emacs scratch
*.swp
.atom/
.history/


##### Flutter / Dart / Pub #####
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/build
**/build/

# Web-target generated registrant
lib/generated_plugin_registrant.dart

# Symbolication / obfuscation artefacts
app.*.symbols
app.*.map.json

# Coverage
coverage/
*.lcov
.test_coverage/
test/.test_coverage.dart

# Generated source (uncomment if your team doesn't commit codegen output)
# *.g.dart
# *.freezed.dart
# *.mocks.dart


##### Gradle #####
.gradle/
gradle-app.setting
.gradletasknamecache

# Keep the wrapper jar even though *.jar is otherwise ignored
!gradle/wrapper/gradle-wrapper.jar


##### Android #####

# AS places build artefacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android build outputs
*.apk
*.aab
*.ap_
*.dex
*.class

# Android tooling
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
local.properties

# Keystores — never commit production signing material
*.jks
*.keystore


